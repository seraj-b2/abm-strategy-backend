PORT=3001
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/abm_strategy_mcp
JWT_SECRET=your_super_secret_jwt_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
NODE_ENV=development

# Canonical public URL of this backend AS SEEN FROM THE INTERNET, used in
# OAuth discovery metadata (issuer, authorization_endpoint, token_endpoint)
# and in redirect_uri validation. If this service sits behind a reverse proxy
# path prefix (e.g. nginx location /api/ -> proxy_pass .../ which strips the
# prefix), that prefix MUST be included here, e.g. https://mcp.seraj.live/api
PUBLIC_BASE_URL=http://localhost:3001
